# Built-in TypeSafe key — SERVER ONLY. Never expose to the frontend bundle.
JEV_PROVIDER=typesafe
JEV_API_KEY=

# Admin token for POST/GET /api/admin/codes (redeem admin; optional if using Bearer admin)
ADMIN_TOKEN=

# Username/password auth + conversation sync for product review
AUTH_ENABLED=true
TRIAL_LIMIT=3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional data directory (default: /opt/crush-monitor/data in prod, ./data locally)
# CRUSH_DATA_DIR=/opt/crush-monitor/data

PORT=3178
HOST=0.0.0.0

# Redeem / daily quota gate. false = unlimited open access via server key.
REDEEM_ENABLED=false
